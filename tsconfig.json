{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["es2023"],
    "module": "node20",
    "noImplicitAny": false,
    "outDir": "./dist",
    "resolveJsonModule": true,
    "rootDir": ".",
    "sourceMap": true,
    "strict": true,
    "strictNullChecks": false,
    "target": "es2023",
    "types": ["node"]
  },
  "include": ["index.ts", "src/**/*.ts", "bench/**/*.ts"]
}
