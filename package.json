{
  "name": "@devicefarmer/adbkit",
  "version": "3.3.9",
  "description": "A Typescript client for the Android Debug Bridge.",
  "keywords": [
    "adb",
    "adbkit",
    "android",
    "logcat",
    "typescript",
    "monkey"
  ],
  "bin": {
    "adbkit": "./bin/adbkit"
  },
  "bugs": {
    "url": "https://github.com/devicefarmer/adbkit/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Device Farmer",
    "email": "contact@devicefarmer.com",
    "url": "https://devicefarmer.com/"
  },
  "contributors": [
    {
      "name": "uriel chemouni",
      "email": "uchemouni@gmail.com",
      "url": "https://urielch.github.io/urielch/"
    }
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adb/parser": {
      "types": "./dist/src/adb/parser.d.ts",
      "default": "./dist/src/adb/parser.js"
    },
    "./adb/sync/pushtransfer": {
      "types": "./dist/src/adb/sync/pushtransfer.d.ts",
      "default": "./dist/src/adb/sync/pushtransfer.js"
    },
    "./adb/tcpusb/server": {
      "types": "./dist/src/adb/tcpusb/server.d.ts",
      "default": "./dist/src/adb/tcpusb/server.js"
    },
    "./dist/src/adb/parser.js": {
      "types": "./dist/src/adb/parser.d.ts",
      "default": "./dist/src/adb/parser.js"
    },
    "./dist/src/adb/sync/pushtransfer.js": {
      "types": "./dist/src/adb/sync/pushtransfer.d.ts",
      "default": "./dist/src/adb/sync/pushtransfer.js"
    },
    "./dist/src/adb/tcpusb/server.js": {
      "types": "./dist/src/adb/tcpusb/server.d.ts",
      "default": "./dist/src/adb/tcpusb/server.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeviceFarmer/adbkit.git"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "keycode": "node tasks/keycode.js",
    "prepublishOnly": "npm run clean && npm run compile && npm run test",
    "compile": "tsc -p .",
    "format": "prettier --write . && eslint . --fix",
    "lint": "eslint . && prettier --check .",
    "pretest": "npm run compile",
    "test": "mocha"
  },
  "dependencies": {
    "@devicefarmer/adbkit-logcat": "^2.1.2",
    "@devicefarmer/adbkit-monkey": "~1.2.1",
    "commander": "^9.1.0",
    "debug": "~4.3.1",
    "node-forge": "^1.3.1",
    "split": "~1.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/debug": "^4.1.5",
    "@types/node": "^22.20.5",
    "@types/node-forge": "^1.0.1",
    "bench": "~0.3.6",
    "chai": "^6.3.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "sinon": "^22.1.0",
    "sinon-chai": "^4.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">= 22"
  }
}
